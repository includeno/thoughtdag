{
  "name": "thoughtdag-desktop",
  "private": true,
  "version": "0.3.31",
  "description": "Desktop shell for ThoughtDAG — same app, same server, one window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "payload": "node scripts/prepare-payload.mjs",
    "package": "node scripts/package.mjs",
    "pack:dir": "node scripts/package.mjs --mode dir --sign never",
    "dist:local": "node scripts/package.mjs --sign never",
    "dist:mac": "node scripts/package.mjs --platform mac --arch all",
    "dist:mac:arm64": "node scripts/package.mjs --platform mac --arch arm64",
    "dist:mac:x64": "node scripts/package.mjs --platform mac --arch x64",
    "dist:mac:universal": "node scripts/package.mjs --platform mac --arch universal",
    "dist:win": "node scripts/package.mjs --platform win --arch x64",
    "dist:win:arm64": "node scripts/package.mjs --platform win --arch arm64",
    "dist:linux": "node scripts/package.mjs --platform linux --arch x64",
    "dist:linux:arm64": "node scripts/package.mjs --platform linux --arch arm64"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.chenxiachan.thoughtdag",
    "productName": "ThoughtDAG",
    "icon": "build/icon.png",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "chenxiachan",
      "repo": "thoughtdag"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
